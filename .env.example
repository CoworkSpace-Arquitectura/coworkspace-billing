# Copia este archivo como .env y cambia los valores. Nunca subas el .env al repositorio.

# Base de datos PostgreSQL del servicio (en producción: Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coworkspace_billing

# Puerto HTTP
PORT=3005

# Bus de eventos (en producción: Upstash Redis)
REDIS_URL=redis://localhost:6379

# Stripe en modo de prueba: usa una llave sk_test_ de tu panel de Stripe
STRIPE_SECRET_KEY=sk_test_reemplazar

# Dirección del sitio (a donde vuelve el usuario después de pagar)
FRONTEND_URL=http://localhost:3010

# Dirección pública de este servicio
PUBLIC_URL=http://localhost:3005
